<!-- Chassis -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tp_car">
    <xacro:arg name="tp_num" default="3"/>
    <xacro:property name="tp_count" value="$(arg tp_num)"/>
    <xacro:property name="use_dynamic_tps_config" value="false"/>
    <!-- Color-->
    <material name="blue">
        <color rgba="0.2 0.2 0.8 0.9"/>
    </material>

    <!-- Root coordinate -->
    <link name="map"/>

    <!-- tp car function -->
    <xacro:macro name="create_tp_car" params="id car_length car_width car_height color">
        <!-- projection point of the chasis on the map -->
        <link name="base_footprint_tp${id}"/> 
        
        <!-- chasis-->
         <link name="base_link_tp${id}">
            <visual>
                <geometry>
                    <box size="${car_length} ${car_width} ${car_height}"/>
                </geometry>
                <material name="${color}"/>
            </visual>
        </link>

        <!-- projection point to the map -->
        <joint name="footprint${id}_to_map" type="fixed">
            <parent link="map"/>
            <child link="base_footprint_tp${id}"/>
        </joint>

        <!-- chasis to the projection point -->
        <joint name="base_to_footprint${id}" type="fixed">
            <parent link="base_footprint_tp${id}"/>
            <child link="base_link_tp${id}"/>
            <origin xyz="0.0 0.0 ${car_height / 2.0}"/>
        </joint>
    </xacro:macro>

    <!-- function call, controlled by tp_num arg -->
    <!-- static tps config -->
    <xacro:if value="${not use_dynamic_tps_config}">
      <xacro:if value="${int(tp_count) >= 1}">
        <xacro:create_tp_car id="1" car_length="3.0" car_width="1.6" car_height="1.2" color="blue"/>
      </xacro:if>
      <xacro:if value="${int(tp_count) >= 2}">
        <xacro:create_tp_car id="2" car_length="3.0" car_width="1.6" car_height="1.2" color="blue"/>
      </xacro:if>
      <xacro:if value="${int(tp_count) >= 3}">
        <xacro:create_tp_car id="3" car_length="3.0" car_width="1.6" car_height="1.2" color="blue"/>
      </xacro:if>
    </xacro:if>
    <!-- dynamic tps config -->
    <xacro:if value="${use_dynamic_tps_config}">
      <xacro:if value="${int(tp_count) >= 1}">
        <xacro:create_tp_car id="1" car_length="8.0" car_width="2.6" car_height="1.2" color="blue"/>
      </xacro:if>
      <xacro:if value="${int(tp_count) >= 2}">
        <xacro:create_tp_car id="2" car_length="6.0" car_width="2.0" car_height="1.2" color="blue"/>
      </xacro:if>
      <xacro:if value="${int(tp_count) >= 3}">
        <xacro:create_tp_car id="3" car_length="3.0" car_width="7.6" car_height="1.2" color="blue"/>
      </xacro:if>
    </xacro:if>

</robot>