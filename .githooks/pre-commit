#!/bin/bash
# check clang-format
required_version="18.1.8"
current_version=$(clang-format --version | awk '{print $3}')

if [ "$(printf '%s\n' "$required_version" "$current_version" | sort -V | head -n1)" != "$required_version" ]; then
    echo "Error: clang-format version must be at least $required_version"
    echo "Found version: $current_version"
    echo "Please install the required version"
    exit 1
fi

# Get project root directory (Windows compatible)
root_dir=$(git rev-parse --show-toplevel)
echo "root dir is: $root_dir"

# Define excluded directories (relative paths)
excluded_dirs=(
  "doc"
  "scripts"
  "test"
)

# Special exclusion rules for specific directories
special_exclusions=(
  "src/base_msgs/*"
)

# Get all staged C/C++ files
# Get all C/C++ files in project root (recursively), excluding specified directories
all_files=$(git diff --cached --name-only --diff-filter=ACM -- *.cpp *.h *.c *.hpp)
# Get all C/C++ files in project root (recursively), excluding specified directories
# all_files=$(find "$root_dir" \( -path "$root_dir/conan_workarea" -o -path "$root_dir/venv" -o -path "$root_dir/CMakeFiles" -o -path "$root_dir/build" -o -path "$root_dir/.git" -o -path "$root_dir/external" \) -prune -false -o \( -name "*.cpp" -o -name "*.c" -o -name "*.h" -o -name "*.hpp" \) -type f -print)

# Filter out excluded files
files_to_format=""
for file in $all_files; do
  exclude_file=0

  # Check if file is in excluded directories
  for pattern in "${excluded_dirs[@]}"; do
    if [[ "$file" == *"$pattern"* ]]; then
      exclude_file=1
      break
    fi
  done

  # Check special exclusion rules
  if [[ "$exclude_file" -eq 0 ]]; then
    for pattern in "${special_exclusions[@]}"; do
      # Windows path compatibility
      win_pattern=$(echo "$pattern" | sed 's/\//\\/g')
      win_file=$(echo "$file" | sed 's/\//\\/g')

      if [[ "$win_file" == *"$win_pattern"* ]]; then
        exclude_file=1
        break
      fi
    done
  fi

  # Add to format list if not excluded
  if [[ "$exclude_file" -eq 0 ]]; then
    files_to_format="$files_to_format $file"
  fi
done

# Format files
if [[ -n "$files_to_format" ]]; then
  echo "Running clang-format on staged files..."

  # Use eval to handle file paths with spaces
  eval clang-format -i -style=file $files_to_format

  # Re-add formatted files to staging (optional)
  #eval git add $files_to_format

  echo "Formatted $(echo $files_to_format | wc -w) files"
else
  echo "No files to format after exclusions"
fi

exit 0